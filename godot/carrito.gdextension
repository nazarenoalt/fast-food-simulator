; Carga la librería de Rust (rust/game). Compilala con `cargo build` dentro de rust/.
[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
linux.debug.x86_64 = "res://../rust/target/debug/libcarrito_game.so"
linux.release.x86_64 = "res://../rust/target/release/libcarrito_game.so"
windows.debug.x86_64 = "res://../rust/target/debug/carrito_game.dll"
windows.release.x86_64 = "res://../rust/target/release/carrito_game.dll"
macos.debug = "res://../rust/target/debug/libcarrito_game.dylib"
macos.release = "res://../rust/target/release/libcarrito_game.dylib"
macos.debug.arm64 = "res://../rust/target/debug/libcarrito_game.dylib"
macos.release.arm64 = "res://../rust/target/release/libcarrito_game.dylib"
