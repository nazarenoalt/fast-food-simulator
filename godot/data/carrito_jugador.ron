// El carrito del jugador (SPEC-006, REQ-CAR-07).
// Probá cambiar "carro_kiosco" por "barra_chica", "barra_mediana" o "carro_grande"
// (en esas bases van "lateral" para el estante, "sombra" para la sombrilla y "luz_1" para el foco).
(
    base: "carro_kiosco",
    color: Some((0.78, 0.13, 0.1)), // REQ-CAR-09: estilo propio
    accesorios: {
        "mostrador_izq": "hervidor_chico",
        "mostrador_der": "aderecera_tres",
        "atras_der": "estante_deposito",
        "frente": "telon_panchos",
        "lateral_der": "porche_nylon",
    },
    // Bloque que va en cada lugar del depósito (None = vacío).
    stock: {
        "atras_der": [Some("bolsa_panes_12"), Some("caja_salchichas_12"), Some("caja_salchichas_12"), None],
    },
)
