// SPEC-019 · Eventos de la plaza (REQ-EVE-02). Días: Lun Mar Mie Jue Vie Sab Dom (el día 1 es
// lunes, REQ-EVE-01; la primera semana no hay eventos, REQ-EVE-10). Cada tramo: horas desde el
// comienzo del día del evento (pueden pasar de 24), multiplicadores de gente y clientes (o
// `clientes_entre`: sorteado una vez por evento), perfiles que se suman y chance de camiseta.
[
    (
        id: "feria",
        aviso: "feria en la plaza de 10 a 18",
        dias: [Sab, Dom],
        tramos: [
            // REQ-EVE-05: los puestos están armados de 6 a 22.
            (id: "puestos", desde: 6.0, hasta: 22.0),
            // REQ-EVE-06
            (id: "feria", desde: 10.0, hasta: 18.0, gente: 1.5, clientes: 1.3, perfiles: [(Familia, 3.0), (Jubilado, 2.0)]),
        ],
    ),
    (
        id: "partido",
        aviso: "juega el equipo del barrio a las 21",
        dias: [Mie, Dom],
        // REQ-EVE-07: rojo y azul.
        equipos: [(0.85, 0.12, 0.15), (0.1, 0.32, 0.8)],
        tramos: [
            (id: "previa", desde: 18.0, hasta: 21.0, camisetas: 0.5),
            // REQ-EVE-08
            (id: "partido", desde: 21.0, hasta: 23.0, gente: 0.3, clientes: 0.3),
            // REQ-EVE-09: hasta las 0:30 del día siguiente; clientes entre ×2 y ×4, sorteado en
            // cada partido.
            (id: "festejo", desde: 23.0, hasta: 24.5, clientes_entre: Some((2.0, 4.0)), perfiles: [(Nocturno, 8.0)], camisetas: 1.0),
        ],
    ),
]
