    pallet: Some((-1.5, 0.0, -1.9)), // REQ-AMP-02: atrás, lejos de la puerta
    puerta: Some(100.0), // REQ-AMP-01: se abre 100° hacia afuera...
    puerta_abierta: false, // ...y arranca cerrada
