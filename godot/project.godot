; Proyecto de Godot. La lógica está en Rust (../rust), cargada por carrito.gdextension.

config_version=5

[application]

config/name="Fast Food Simulator"
config/description="Simulador de carrito de comida rápida"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true
; REQ-DIA-08 (TASK-0258): sombras del sol estables mientras se mueve (ver dia_noche.rs).
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
